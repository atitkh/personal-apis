# Server Configuration
PORT=3000
NODE_ENV=development


# Hub database (SQLite). Defaults to ./data/hub.db; override the folder or the file if needed
# HUB_DATA_DIR=
# HUB_DB_FILE=

# Admin dashboard sign-in (/admin). 32+ random characters; leave unset to switch the dashboard off
ADMIN_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Legacy API Key
API_KEY=

# NFT / Web3
NFTPORTAL_KEY=
OPENSEA_KEY=
JSONRPCPROVIDER_ETH=

# Google Service Account (escape newlines in private key as \n)
SA_EMAIL=
SA_PRIVATE_KEY=
ATTENDANCE_CLIENT_ID=
ATTENDANCE_CLIENT_SECRET=
ATTENDANCE_SHEET_ID=
SHEETS_API_KEY=
