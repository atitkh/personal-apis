# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/personal-apis
DB_CONNECTION=mongodb://localhost:27017/personal-apis

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
TOKEN_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Legacy API Key
API_KEY=

# NFT / Web3
NFTPORTAL_KEY=
OPENSEA_KEY=
JSONRPCPROVIDER_ETH=

# Google Service Account (escape newlines in private key as \n)
SA_EMAIL=
SA_PRIVATE_KEY=
ATTENDANCE_CLIENT_ID=
ATTENDANCE_CLIENT_SECRET=
ATTENDANCE_SHEET_ID=
SHEETS_API_KEY=
