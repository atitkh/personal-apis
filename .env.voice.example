# Voice Service Configuration - Wyoming Protocol
# Copy this file to .env.voice and update the values for your setup

# Wyoming Protocol Whisper Configuration (ASR - Automatic Speech Recognition)
WHISPER_BASE_URL=http://localhost:10300
WHISPER_MODEL=base
WHISPER_LANGUAGE=en

# Wyoming Protocol Piper Configuration (TTS - Text-to-Speech)
PIPER_BASE_URL=http://localhost:10200
PIPER_DEFAULT_VOICE=en_US-amy-medium

# Voice Processing Settings
VOICE_DEFAULT_INPUT_LANGUAGE=en
VOICE_DEFAULT_OUTPUT_FORMAT=wav
VOICE_DEFAULT_SPEECH_SPEED=1.0
VOICE_SUPPORTED_FORMATS=wav,mp3,ogg,flac,m4a,webm

# Debug Settings
VOICE_DEBUG_ENABLED=true
VOICE_LOG_LEVEL=info

# Wyoming Protocol Setup Instructions:
# 
# 1. Install Wyoming Protocol services:
#    pip install wyoming-whisper wyoming-piper
#
# 2. Start Whisper ASR service:
#    python -m wyoming_whisper --model base --language en --uri tcp://0.0.0.0:10300
#
# 3. Start Piper TTS service:
#    python -m wyoming_piper --voice en_US-amy-medium --uri tcp://0.0.0.0:10200
#
# 4. Verify services are running:
#    curl http://localhost:10300/info  # Should return ASR service info
#    curl http://localhost:10200/info  # Should return TTS service info
#
# 5. Copy this file to .env.voice and adjust URLs/ports as needed
#
# For more voice models and configuration options, see:
# - Whisper models: https://github.com/rhasspy/wyoming-whisper
# - Piper voices: https://github.com/rhasspy/wyoming-piper